# Copy to scripts/aws-setup/.state/canary.env and fill in non-secret values.
# DAYTONA_API_KEY, CLOUDFLARE_API_TOKEN, and the AWS session arrive through
# devflow; do not put those credentials in this file.
export EXPECTED_COMMIT="<reviewed-branch-head-sha>"
export EXPECTED_AWS_ACCOUNT_ID="123456789012"
export AWS_REGION="us-west-2"

export CLUSTER_NAME="daytona-v0199-canary"
export BASE_DOMAIN="byoc.example.com"
export REGION_NAME="daytona-v0199-canary"
export CLUSTER_ISSUER_EMAIL="operator@example.com"
export S3_BUCKET="daytona-v0199-canary-123456789012-us-west-2"

export DAYTONA_API_URL="https://app.daytona.io/api"
export DAYTONA_IMAGE_PROFILE="v0.199-canary"
export RUNNER_AWS_CREDENTIAL_MODE="static"
export RUNNER_IMAGE_REF="123456789012.dkr.ecr.us-west-2.amazonaws.com/daytona-runner:v0.199.0-byoc-amd64-object-storage"
# Required when BUILD_RUNNER_IMAGE=false; copy from the verified build/push.
export RUNNER_IMAGE_DIGEST="sha256:<verified-image-digest>"
export RUNNER_MANAGER_IMAGE_REF="123456789012.dkr.ecr.us-west-2.amazonaws.com/daytona-runner-manager:v0.184.0-k8s-oss.5-v0199-api-autoscale-amd64"
export RUNNER_MANAGER_IMAGE_DIGEST="sha256:<verified-runner-manager-image-digest>"
export RUNNER_MANAGER_SOURCE_COMMIT="3fc5b6daeab06b13bc97edc3cf378bf15f78c588"
export AWS_NODE_VOLUME_SIZE_GB="250"

# Runner-manager and EKS use one shared capacity envelope. The defaults keep
# three ready runners and allow demand-based scale-out to ten EKS worker nodes.
export RUNNER_MIN_COUNT="3"
export RUNNER_MAX_COUNT="10"
export RUNNER_SCALE_UP_THRESHOLD="25"
export RUNNER_SCALE_DOWN_THRESHOLD="75"
export RUNNER_MAXIMUM_CONCURRENT_INITIALIZING="2"
export RUNNER_MAXIMUM_CONCURRENT_DRAINING="1"
export RUNNER_SCALE_DOWN_STABILIZATION_SECONDS="30"
export EKS_VERSION="1.36"
export CLUSTER_AUTOSCALER_CHART_VERSION="9.58.0"
export CLUSTER_AUTOSCALER_IMAGE_TAG="v1.36.0"

# Set true only in a Docker-in-Docker-capable Daytona snapshot. Otherwise the
# script verifies that RUNNER_IMAGE_REF already exists before provisioning.
export BUILD_RUNNER_IMAGE="false"
export BUILD_RUNNER_MANAGER_IMAGE="false"
# When BUILD_RUNNER_IMAGE=true, build from the official v0.199 source layout
# and apply the BYOC object-storage patch instead of wrapping a release binary.
export RUNNER_SOURCE_BUILD="true"

# Stage C needs this org id and creates temporary ECR verification resources.
# It is an identifier, not a credential.
export DAYTONA_ORG_ID="<daytona-org-id>"
export RUN_STAGE_C="true"
export RUN_NETWORK_SMOKE="true"
