@@ -64,0 +82,51 @@ func GetObjectStorageClient() (ObjectStorageClient, error) {
+func getControlPlaneObjectStorageClient(apiURL, token string) (ObjectStorageClient, error) {
+	if apiURL == "" {
+		return nil, fmt.Errorf("DAYTONA_API_URL is required for control-plane object storage")
+	}
+
+	req, err := http.NewRequest(http.MethodGet, strings.TrimRight(apiURL, "/")+"/object-storage/push-access", nil)
+	if err != nil {
+		return nil, fmt.Errorf("failed to create storage access request: %w", err)
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+
+	resp, err := (&http.Client{Timeout: 20 * time.Second}).Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("failed to request storage access: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("storage access request returned HTTP %d", resp.StatusCode)
+	}
+
+	var access storageAccess
+	if err := json.NewDecoder(resp.Body).Decode(&access); err != nil {
+		return nil, fmt.Errorf("failed to decode storage access response: %w", err)
+	}
+
+	useSSL := strings.HasPrefix(access.StorageURL, "https://")
+	endpoint := strings.TrimPrefix(access.StorageURL, "http://")
+	endpoint = strings.TrimPrefix(endpoint, "https://")
+	region := "us-east-1"
+	parts := strings.Split(endpoint, ".")
+	if len(parts) >= 4 && parts[0] == "s3" && parts[2] == "amazonaws" {
+		region = parts[1]
+	}
+	if endpoint == "" || access.AccessKey == "" || access.Secret == "" || access.Bucket == "" {
+		return nil, fmt.Errorf("control-plane object storage response is incomplete")
+	}
+
+	client, err := minio.New(endpoint, &minio.Options{
+		Creds:  credentials.NewStaticV4(access.AccessKey, access.Secret, access.SessionToken),
+		Secure: useSSL,
+		Region: region,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("failed to create control-plane S3 client: %w", err)
+	}
+	return &minioClient{
+		client:     client,
+		bucketName: access.Bucket,
+	}, nil
+}
+
